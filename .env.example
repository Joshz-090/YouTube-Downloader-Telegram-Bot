# ─── Required ───────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
ADMIN_ID=123456789

# ─── Local Telegram Bot API (get from https://my.telegram.org) ───
API_ID=12345
API_HASH=your_api_hash_here
# URL of the self-hosted telegram-bot-api server (see docker-compose.yml)
LOCAL_API_URL=http://localhost:8081

# ─── Optional ────────────────────────────────────────────
# Path to cookies.txt (Netscape format) from a THROWAWAY YouTube account
# Never use your main account. Export with: yt-dlp --cookies-from-browser chrome --cookies cookies.txt https://youtube.com
COOKIES_PATH=

# SOCKS5/HTTP proxy as escape hatch for geo-blocking
PROXY=

# Max simultaneous downloads (default: 3)
MAX_PARALLEL=3

# Max video duration in seconds (default: 10800 = 3h)
MAX_DURATION=10800

# Temp directory for downloads (deleted after upload)
TMP_DIR=/tmp/ytdlbot

# Allow playlist URLs? 0=reject (default), 1=allow first video only
ALLOW_PLAYLISTS=0

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SQLite database path
DB_PATH=data/bot.db
